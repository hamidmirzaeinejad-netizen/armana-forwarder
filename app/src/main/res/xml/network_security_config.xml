<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS is used whenever the site has it; plain HTTP stays possible for a site without a certificate (the app warns). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
